# Copy to .env and adjust. Never commit .env.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Mock API key for the x-api-key middleware. Replace with real auth on Day 1.
API_KEY=dev-key-change-me

# SQLite database file (dev)
DATABASE_URL=file:./dev.db

# SQLite database file (tests)
TEST_DATABASE_URL=file:./test.db

# CORS allowed origin (dev default: allow all)
CORS_ORIGIN=*
